# Drizzle / SQLite
DATABASE_URL=local.db

# Local model server
OLLAMA_URL=http://127.0.0.1:11434

# Image and file attachments are sent as JSON, so allow more than the 512 kB default.
BODY_SIZE_LIMIT=12M

# Optional cloud providers. Leave empty to disable them in the model picker.
# GROQ_API_KEY=
# GEMINI_API_KEY=
